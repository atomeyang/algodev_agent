# Algo-Agent credentials / endpoints example. Copy to .env. Never commit real secrets.
# --- Cloud research/design provider (OpenAI-compatible) ---
ALGO_CLOUD_PROVIDER=deepseek
ALGO_CLOUD_BASE_URL=https://api.deepseek.com/v1
ALGO_CLOUD_API_KEY=
ALGO_CLOUD_MODEL=deepseek-flash
# Optional per-role overrides; empty values inherit the cloud model.
ALGO_RESEARCH_MODEL=
ALGO_CHAT_MODEL=
ALGO_INTENT_MODEL=
ALGO_INTENT_LLM=1
# Includes reasoning tokens; truncated research JSON is rejected and repaired.
ALGO_RESEARCH_MAX_TOKENS=16384
# --- Literature search (opt in before sending technical queries externally) ---
# ALGO_SEARCH_BACKEND=arxiv
# ALGO_SEARCH_BACKEND=http
ALGO_SEARCH_URL=
# --- Local auxiliary model ---
ALGO_LOCAL_BASE_URL=http://127.0.0.1:8084/v1
ALGO_LOCAL_MODEL=qwen3.8-27b
ALGO_LOCAL_API_KEY=
# --- Runtime Codex coding tool ---
ALGO_CODEX_BIN=codex
ALGO_CODEX_ALLOW_REAL=0
# Empty coding model snapshots the installed CLI's top-level model configuration.
ALGO_CODING_MODEL=
ALGO_CODING_REASONING_EFFORT=
# local | ssh. SSH moves coding only; research, evaluation and GPU jobs stay local.
ALGO_CODING_TRANSPORT=local
# Use an already verified SSH host alias. No automatic host-key acceptance.
ALGO_CODING_SSH_HOST=
# Dedicated directory on the remote Linux VM, owned by its worker user, mode 0700.
ALGO_CODING_SSH_ROOT=
ALGO_CODING_SSH_PYTHON=python3
ALGO_CODING_SSH_CODEX=codex
# --- Control service ---
ALGO_SERVICE_HOST=127.0.0.1
ALGO_SERVICE_PORT=8765

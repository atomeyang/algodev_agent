# Algo-Agent credentials example. Copy to .env. Never commit real secrets.
ALGO_CLOUD_PROVIDER=deepseek
ALGO_CLOUD_BASE_URL=https://api.deepseek.com/v1
ALGO_CLOUD_API_KEY=
ALGO_CLOUD_MODEL=deepseek-chat
ALGO_LOCAL_BASE_URL=http://127.0.0.1:8000/v1
ALGO_LOCAL_MODEL=qwen3-27b
ALGO_LOCAL_API_KEY=
ALGO_CODEX_BIN=codex
ALGO_CODEX_ALLOW_REAL=0
ALGO_SEARCH_URL=
ALGO_SERVICE_HOST=127.0.0.1
ALGO_SERVICE_PORT=8765

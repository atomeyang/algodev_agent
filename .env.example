# Algo-Agent credentials / endpoints example. Copy to .env. Never commit real secrets.
# --- Cloud research/design provider (OpenAI-compatible) ---
ALGO_CLOUD_PROVIDER=deepseek
ALGO_CLOUD_BASE_URL=https://api.deepseek.com/v1
ALGO_CLOUD_API_KEY=
ALGO_CLOUD_MODEL=deepseek-flash  # DeepSeek-V4-Flash
ALGO_CLOUD_EST_INPUT_TOKENS=6000
ALGO_CLOUD_EST_OUTPUT_TOKENS=2000
ALGO_CLOUD_PRICE_INPUT_PER_1K=0.00027
ALGO_CLOUD_PRICE_OUTPUT_PER_1K=0.0011
ALGO_CLOUD_CURRENCY=USD
ALGO_CLOUD_PRICE_VERSION=2026-01
# --- Local auxiliary model ---
ALGO_LOCAL_BASE_URL=http://127.0.0.1:8084/v1
ALGO_LOCAL_MODEL=qwen3.8-27b
ALGO_LOCAL_API_KEY=
# --- Runtime Codex coding tool ---
ALGO_CODEX_BIN=codex
ALGO_CODEX_ALLOW_REAL=0
# --- Control service ---
ALGO_SERVICE_HOST=127.0.0.1
ALGO_SERVICE_PORT=8765
